rule phyml:
    """Build starting tree for ClonalFrameML using PhyML."""
    input:
        phylip="results/cgsnp/mpileup2cns_nondupli_tran.phy",
    output:
        tree="results/cgsnp/mpileup2cns_nondupli_tran.phy_phyml_tree.txt",
        stats="results/cgsnp/mpileup2cns_nondupli_tran.phy_phyml_stats.txt",
    params:
        model=config["phyml"]["model"],
        bootstrap=config["phyml"]["bootstrap"],
    shell:
        """
        cd results/cgsnp && \
        phyml -i $(basename {input.phylip}) -m {params.model} -b {params.bootstrap}
        """


rule raxml_pre_cfml:
    """Build reference tree before ClonalFrameML using RAxML."""
    input:
        fasta="results/cgsnp/mpileup2cns_nondupli_tran.fasta",
    output:
        tree="results/cgsnp/RAxML_bestTree.mpileup2cns_nondupli_tran_RAxML",
    params:
        model=config["raxml"]["model"],
        threads=config["raxml"]["threads"],
        seed=config["raxml"]["seed"],
        bootstrap=config["raxml"]["bootstrap_pre_cfml"],
    shell:
        """
        cd results/cgsnp && \
        rm -f *RAxML*mpileup2cns_nondupli_tran_RAxML* && \
        raxmlHPC-PTHREADS -f a \
            -s $(basename {input.fasta}) \
            -n mpileup2cns_nondupli_tran_RAxML \
            -m {params.model} -T {params.threads} \
            -x {params.seed} -p{params.seed} -# {params.bootstrap}
        """


rule calc_kappa:
    """Calculate kappa (transition/transversion ratio) from PhyML stats."""
    input:
        stats="results/cgsnp/mpileup2cns_nondupli_tran.phy_phyml_stats.txt",
    output:
        kappa="results/cgsnp/kappa.txt",
    params:
        script=os.path.join(SCRIPTS_DIR, "calc_kappa.py"),
    shell:
        """
        python {params.script} -i {input.stats} -o {output.kappa}
        """


rule clonalframeml:
    """Detect homologous recombination regions using ClonalFrameML."""
    input:
        tree="results/cgsnp/mpileup2cns_nondupli_tran.phy_phyml_tree.txt",
        fasta="results/cgsnp/mpileup2cns_tran.fasta",
        kappa="results/cgsnp/kappa.txt",
    output:
        importation="results/cgsnp/mpileup2cns_tran.importation_status.txt",
    shell:
        r"""
        kappa=$(cat {input.kappa})
        cd results/cgsnp && \
        ClonalFrameML \
            $(basename {input.tree}) \
            $(basename {input.fasta}) \
            mpileup2cns_tran \
            -kappa $kappa -emsim 100
        """


rule remove_recombination:
    """Exclude homologous recombination regions from alignment."""
    input:
        fasta="results/cgsnp/mpileup2cns_tran.fasta",
        importation="results/cgsnp/mpileup2cns_tran.importation_status.txt",
    output:
        clean_fasta="results/cgsnp/mpileup2cns_tran.recRemoved.fasta",
    params:
        tools_path=TOOLS_PATH,
    shell:
        """
        cd results/cgsnp && \
        python {params.tools_path}/remove_rec_from_ClonalFrameML_output_v1.1.py \
            -a $(basename {input.fasta}) \
            -o $(basename {input.importation})
        """


