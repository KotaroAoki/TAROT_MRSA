"""
TAROT-MRSA: Snakemake workflow for successive cgSNP-based phylogenetic analysis
of methicillin-resistant Staphylococcus aureus (MRSA).

Converted from TAROT_MRSA_successive_cgSNP_analysis.sh
"""

import os
import glob

# ── Load configuration ──────────────────────────────────────────────────────
configfile: "config/config.yaml"

SAMPLES      = config["samples"]
SAMPLE_DIR   = config["sample_dir"]
REFERENCE_DIR = config["reference_dir"]
BAM_DIR      = config["bam_dir"]
TOOLS_PATH   = config["tools_path"]
STRINGMLST_DB = config["stringmlst_db"]
GENOME_SIZE  = config["genome_size"]
COVERAGE     = config["coverage"]
THREADS      = config["threads"]
MIN_STRAINS  = config["min_strains_for_snp"]

SCRIPTS_DIR  = os.path.join(workflow.basedir, "scripts")


# ── Utility functions ────────────────────────────────────────────────────────
def get_fastq_patterns(wildcards):
    """Return all .fastq and .fastq.gz files for a sample."""
    d = os.path.join(SAMPLE_DIR, wildcards.sample)
    files = (
        glob.glob(os.path.join(d, "*.fastq"))
        + glob.glob(os.path.join(d, "*.fastq.gz"))
        + glob.glob(os.path.join(d, "*.fq"))
        + glob.glob(os.path.join(d, "*.fq.gz"))
    )
    return sorted(files)


def read_bestref(sample):
    """Read the best reference name from bestref.txt."""
    path = f"results/{sample}/bestref.txt"
    if os.path.exists(path):
        with open(path) as f:
            return f.readline().strip().split("\t")[0]
    return "UNKNOWN"


def read_match_method(sample):
    """Read the matching method (mlst or bbmap) from bestref.txt."""
    path = f"results/{sample}/bestref.txt"
    if os.path.exists(path):
        with open(path) as f:
            parts = f.readline().strip().split("\t")
            return parts[1] if len(parts) > 1 else "mlst"
    return "mlst"


