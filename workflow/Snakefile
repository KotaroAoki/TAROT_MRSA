# ── Full cgSNP analysis target ───────────────────────────────────────────────
rule cgsnp_analysis:
    """Run the full cgSNP analysis pipeline."""
    input:
        tree="results/cgsnp/RAxML_bestTree.final_RAxML",
        dist="results/cgsnp/snp_distance.tsv",
        pre_tree="results/cgsnp/RAxML_bestTree.mpileup2cns_nondupli_tran_RAxML",
